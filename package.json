{
  "name": "userchrome-js-loader",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm test && npm run build",
    "lint": "eslint src scripts tests eslint.config.js --max-warnings 0",
    "prepare": "simple-git-hooks",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:compat": "node scripts/compat-test.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "simple-git-hooks": "^2.14.0"
  },
  "allowScripts": {
    "simple-git-hooks": true
  }
}
